# npm start loads this file after you copy it to .env.
# Shell environment variables take precedence over these values.
COGNITIO_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=replace_with_your_key

# Optional Anthropic alternative: change COGNITIO_MODEL as well.
# COGNITIO_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=replace_with_your_key
